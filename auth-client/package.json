{
  "name": "@7edge/auth-client",
  "version": "0.2.1",
  "description": "Plug-and-play frontend authentication library — headless core methods, React hooks, and prebuilt UI screens, all from one entry point.",
  "keywords": [
    "authentication",
    "auth",
    "react",
    "jwt",
    "otp",
    "refresh-token"
  ],
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./ui/style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./config": "./dist/config.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./src/ui/styles.css -o ./dist/style.css --minify",
    "build": "npm run build:js && npm run build:css && npm run build:config && npm run build:templates && npm run build:bin",
    "prepare": "npm run build",
    "lint": "eslint .",
    "verify": "node scripts/verify-package.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "postinstall": "node bin/postinstall.mjs",
    "build:bin": "node -e \"require('fs').cpSync('bin','dist/bin',{recursive:true})\"",
    "build:dist-repo": "node scripts/build-dist-repo.mjs",
    "set-repo": "node scripts/set-repo.mjs",
    "build:config": "node -e \"require('fs').copyFileSync('src/config.js','dist/config.js')\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishan666/auth-client.git"
  },
  "bin": {
    "auth-client": "./bin/auth-client.mjs"
  }
}
