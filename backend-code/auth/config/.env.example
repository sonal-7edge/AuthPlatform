# Copy to config/.env.dev (or .env.staging / .env.prod) and fill in.
# deploy.sh reads this so the command line stays short. Command-line flags
# still win over anything set here.
#
#   cp config/.env.example config/.env.dev
#   ./deploy.sh --env dev

AWS_REGION=ap-south-1
# AWS_PROFILE=authplatform-dev

# Cognito — from the user pool stack the admin dashboard generates.
USER_POOL_ID=
USER_POOL_CLIENT_ID=
# Derived from the region + pool id when left empty.
# USER_POOL_ARN=

# Naming. Defaults to authplatform / <project>-<env>-auth / v1.
# PROJECT_NAME=authplatform
# STACK_NAME=
# API_STAGE_NAME=v1

# Artifact bucket. Defaults to <project>-<env>-artifacts-<account-id>,
# created by deploy.sh if it does not exist.
# ARTIFACT_BUCKET=

# Lock this down to the real frontend origin outside dev.
CORS_ALLOW_ORIGIN=*

# LOG_RETENTION_DAYS=30
# CLIENT_SECRET_ARN=
