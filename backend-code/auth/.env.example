# ---------------------------------------------------------------------------
# Copy to .env and fill in. `npm run deploy:env` reads this file and derives
# everything from it — including the stack name, which is
# "<ProjectName>-<Environment>". Nothing here needs editing in samconfig.toml.
#
# .env holds secrets. Keep it out of git.
# ---------------------------------------------------------------------------

# --- naming -----------------------------------------------------------------
# Stack name becomes ${ProjectName}-${Environment}, e.g. "acme-auth-dev".
ProjectName=my-app
Environment=dev
ApiStageName=v1

# Region to deploy into. Falls back to AWS_REGION / AWS_DEFAULT_REGION, then
# to the region embedded in CognitoUserPoolArn.
AWS_REGION=ap-south-1

# --- Cognito (provisioned separately — see README) --------------------------
# The ARN's account MUST match the AWS credentials you deploy with, and its
# pool id must match CognitoUserPoolId. deploy.sh checks both before building,
# because CloudFormation reports a mismatch only as an opaque
# "AWS::EarlyValidation::ResourceExistenceCheck" failure.
CognitoUserPoolId=
CognitoUserPoolArn=
CognitoUserPoolClientId=
# Only if the app client has a secret. Leave empty for a public client.
CognitoClientSecret=

# --- password reset ---------------------------------------------------------
# Signs the short-lived resetToken passed from verify_reset_otp to
# reset_password. Required, no default. Generate with:
#     openssl rand -base64 48
RESET_TOKEN_SECRET=
ResetTokenTtlSeconds=600

# --- API behaviour ----------------------------------------------------------
# Lock this down outside dev.
CorsAllowOrigin=*
LogRetentionInDays=30
LogLevel=info
ThrottlingRateLimit=50
ThrottlingBurstLimit=100

# Set true for exactly ONE stack per account+region — it takes ownership of the
# account-wide API Gateway CloudWatch Logs role. A second stack must use false.
ManageApiGatewayAccount=false
