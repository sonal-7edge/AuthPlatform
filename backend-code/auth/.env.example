AWS_REGION=us-east-1

# Cognito User Pool this package talks to (provisioned separately, see README)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only needed if the app client has a client secret
COGNITO_CLIENT_SECRET=

# Verification codes are generated, delivered and expired by Cognito itself
# (pool message configuration), so there is nothing to configure here.

# Signs the short-lived resetToken handed from verify_reset_otp.js to
# reset_password.js — required, no default (must be a long random secret)
RESET_TOKEN_SECRET=
RESET_TOKEN_TTL_SECONDS=600
